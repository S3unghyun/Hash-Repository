import React, { useState, FormEvent } from 'react';
import { User, Sparkles, Plus, Trash2, RotateCcw, LayoutGrid, CheckCircle } from 'lucide-react';
import { CategoryPreset, Task } from '../types';

interface SettingsViewProps {
  userName: string;
  onUpdateUserName: (name: string) => void;
  focusMessage: string;
  onUpdateFocusMessage: (msg: string) => void;
  categories: CategoryPreset[];
  onAddCategory: (name: string, color: string) => void;
  onDeleteCategory: (id: string) => void;
  tasks: Task[];
  onResetData: () => void;
  onLoadDemoTasks: () => void;
}

export function SettingsView({
  userName,
  onUpdateUserName,
  focusMessage,
  onUpdateFocusMessage,
  categories,
  onAddCategory,
  onDeleteCategory,
  tasks,
  onResetData,
  onLoadDemoTasks
}: SettingsViewProps) {
  const [nameInput, setNameInput] = useState(userName);
  const [focusInput, setFocusInput] = useState(focusMessage);
  
  // Category form
  const [newCatName, setNewCatName] = useState('');
  const [newCatColor, setNewCatColor] = useState('#22c55e');

  const handleSaveProfile = (e: FormEvent) => {
    e.preventDefault();
    onUpdateUserName(nameInput.trim() || 'User');
    onUpdateFocusMessage(focusInput.trim() || 'Keep the momentum going.');
  };

  const handleAddCat = (e: FormEvent) => {
    e.preventDefault();
    if (!newCatName.trim()) return;
    onAddCategory(newCatName.trim(), newCatColor);
    setNewCatName('');
  };

  // Quick statistics calculated dynamically
  const totalTasks = tasks.length;
  const completedTasks = tasks.filter(t => t.completed).length;
  const completionRate = totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;

  const colorOptions = [
    '#22c55e', // Green
    '#3b82f6', // Blue
    '#ec4899', // Pink
    '#f59e0b', // Amber/Yellow
    '#a855f7', // Purple
    '#ef4444', // Red
    '#06b6d4', // Cyan
    '#64748b', // Slate
  ];

  return (
    <div className="space-y-6 animate-fade-in" id="settings-view-container">
      {/* Visual Analytics / Stats Panel */}
      <div className="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/80 rounded-2xl p-5 shadow-sm">
        <h3 className="text-gray-400 dark:text-gray-500 text-[11px] font-bold uppercase tracking-wider mb-3.5">
          Progress Overview
        </h3>
        
        <div className="flex items-center gap-5">
          {/* Dynamic visual metric bar */}
          <div className="relative flex items-center justify-center w-20 h-20 flex-shrink-0">
            <svg className="w-full h-full transform -rotate-90">
              <circle
                cx="40"
                cy="40"
                r="34"
                className="stroke-gray-100 dark:stroke-gray-800 fill-transparent"
                strokeWidth="7"
              />
              <circle
                cx="40"
                cy="40"
                r="34"
                className="stroke-green-500 fill-transparent transition-all duration-500"
                strokeWidth="7"
                strokeDasharray={2 * Math.PI * 34}
                strokeDashoffset={2 * Math.PI * 34 * (1 - completionRate / 100)}
                strokeLinecap="round"
              />
            </svg>
            <div className="absolute text-center">
              <span className="text-lg font-bold text-gray-800 dark:text-gray-150">{completionRate}%</span>
              <p className="text-[9px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-tight">Done</p>
            </div>
          </div>

          <div className="space-y-1.5 flex-grow">
            <h4 className="text-sm font-bold text-gray-800 dark:text-gray-100">
              {completionRate === 100 && totalTasks > 0 ? "Outstanding achievement! 🎉" : "Daily momentum tracking"}
            </h4>
            <div className="grid grid-cols-2 gap-2 text-xs">
              <div className="bg-slate-50 dark:bg-slate-800/30 rounded-xl p-2 border border-slate-100/50 dark:border-slate-800/20">
                <span className="text-[10px] font-bold text-gray-400 uppercase tracking-tight block">Total Tasks</span>
                <span className="text-base font-bold text-gray-800 dark:text-gray-200">{totalTasks}</span>
              </div>
              <div className="bg-slate-50 dark:bg-slate-800/30 rounded-xl p-2 border border-slate-100/50 dark:border-slate-800/20">
                <span className="text-[10px] font-bold text-gray-400 uppercase tracking-tight block">Completed</span>
                <span className="text-base font-bold text-green-600 dark:text-green-500">{completedTasks}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Profile/Identity Settings form */}
      <div className="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/80 rounded-2xl p-5 shadow-sm">
        <h3 className="text-gray-400 dark:text-gray-500 text-[11px] font-bold uppercase tracking-wider mb-4 flex items-center gap-1.5">
          <User className="w-3.5 h-3.5" /> Core Presentation
        </h3>
        <form onSubmit={handleSaveProfile} className="space-y-4">
          <div>
            <label className="block text-xs font-bold text-gray-500 dark:text-gray-400 mb-1.5">
              Your Name
            </label>
            <input
              type="text"
              value={nameInput}
              onChange={(e) => setNameInput(e.target.value)}
              className="w-full bg-slate-50 dark:bg-gray-950 border border-gray-150 dark:border-gray-800 focus:outline-none focus:ring-2 focus:ring-green-400 rounded-xl px-3.5 py-2 text-sm text-gray-800 dark:text-gray-100 font-medium"
              placeholder="e.g., Brandon"
            />
          </div>

          <div>
            <label className="block text-xs font-bold text-gray-500 dark:text-gray-400 mb-1.5">
              Today's Focus Heading
            </label>
            <input
              type="text"
              value={focusInput}
              onChange={(e) => setFocusInput(e.target.value)}
              className="w-full bg-slate-50 dark:bg-gray-950 border border-gray-150 dark:border-gray-800 focus:outline-none focus:ring-2 focus:ring-green-400 rounded-xl px-3.5 py-2 text-sm text-gray-800 dark:text-gray-100 font-medium"
              placeholder="e.g., Keep the momentum going."
            />
          </div>

          <button
            type="submit"
            className="w-full bg-green-500 hover:bg-green-600 font-semibold text-white px-4 py-2 rounded-xl text-xs transition-colors cursor-pointer shadow-sm active:scale-[0.98]"
          >
            Apply Core Presentation
          </button>
        </form>
      </div>

      {/* Categories Presets Creator */}
      <div className="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/80 rounded-2xl p-5 shadow-sm">
        <h3 className="text-gray-400 dark:text-gray-500 text-[11px] font-bold uppercase tracking-wider mb-4 flex items-center gap-1.5">
          <LayoutGrid className="w-3.5 h-3.5" /> Category Manager
        </h3>

        {/* Existing Categories list */}
        <div className="flex flex-wrap gap-2 mb-4">
          {categories.map((cat) => (
            <div
              key={cat.id}
              className="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-800 text-gray-700 dark:text-gray-300"
            >
              <span className="w-2.2 h-2.2 rounded-full" style={{ backgroundColor: cat.color }} />
              <span>{cat.name}</span>
              {categories.length > 1 && (
                <button
                  type="button"
                  onClick={() => onDeleteCategory(cat.id)}
                  className="text-gray-400 hover:text-rose-500 p-0.5 ml-1 select-none active:scale-90"
                  title={`Delete category ${cat.name}`}
                >
                  <Trash2 className="w-3 h-3" />
                </button>
              )}
            </div>
          ))}
        </div>

        {/* Quick add category form */}
        <form onSubmit={handleAddCat} className="space-y-3">
          <div>
            <label className="block text-xs font-bold text-gray-500 dark:text-gray-400 mb-1.5">
              New Category Name
            </label>
            <input
              type="text"
              value={newCatName}
              onChange={(e) => setNewCatName(e.target.value)}
              className="w-full bg-slate-50 dark:bg-gray-950 border border-gray-150 dark:border-gray-800 focus:outline-none focus:ring-2 focus:ring-green-400 rounded-xl px-3.5 py-1.5 text-xs text-gray-800 dark:text-gray-100 font-medium"
              placeholder="e.g., Study, Health"
            />
          </div>

          <div>
            <label className="block text-xs font-bold text-gray-500 dark:text-gray-400 mb-1.5">
              Tag Color
            </label>
            <div className="flex gap-2">
              <div className="flex flex-wrap gap-1.5 flex-grow">
                {colorOptions.map((c) => (
                  <button
                    key={c}
                    type="button"
                    onClick={() => setNewCatColor(c)}
                    className={`w-6 h-6 rounded-full border-2 transition-all cursor-pointer ${
                      newCatColor === c ? 'border-gray-600 scale-110' : 'border-transparent hover:scale-105'
                    }`}
                    style={{ backgroundColor: c }}
                  />
                ))}
              </div>
              <button
                type="submit"
                className="bg-green-500 hover:bg-green-600 text-white rounded-xl px-3 flex items-center justify-center transition-colors shadow-sm cursor-pointer"
              >
                <Plus className="w-4 h-4" />
              </button>
            </div>
          </div>
        </form>
      </div>

      {/* Diagnostics / Utilities */}
      <div className="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/80 rounded-2xl p-5 shadow-sm space-y-3">
        <h3 className="text-gray-400 dark:text-gray-500 text-[11px] font-bold uppercase tracking-wider mb-1 flex items-center gap-1.5">
          Database Diagnostics
        </h3>
        
        <p className="text-[11.5px] text-gray-500 dark:text-gray-400 leading-relaxed font-medium">
          If you are testing the app or want to load dynamic pre-scheduled tasks for testing, use the tools below.
        </p>

        <div className="grid grid-cols-2 gap-2.5 pt-1">
          <button
            type="button"
            onClick={onLoadDemoTasks}
            className="flex items-center justify-center gap-1.5 border border-green-500/20 hover:border-green-500/40 bg-green-50/50 dark:bg-green-950/20 text-green-700 dark:text-green-400 text-xs font-semibold px-3 py-2.5 rounded-xl cursor-pointer transition-colors active:scale-95"
            id="load-demo-btn"
          >
            <Sparkles className="w-3.5 h-3.5" />
            Load Demo Data
          </button>
          
          <button
            type="button"
            onClick={onResetData}
            className="flex items-center justify-center gap-1.5 border border-slate-200 hover:border-rose-500 hover:text-rose-600 hover:bg-rose-50/30 text-gray-600 dark:text-gray-400 text-xs font-semibold px-3 py-2.5 rounded-xl cursor-pointer transition-colors active:scale-95"
            id="reset-data-btn"
          >
            <RotateCcw className="w-3.5 h-3.5" />
            Reset All
          </button>
        </div>
      </div>
    </div>
  );
}
