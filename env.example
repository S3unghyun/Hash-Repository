import React, { useState, FormEvent } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { ChevronLeft, ChevronRight, Calendar, Plus, Check, Circle, Clock } from 'lucide-react';
import { Task, CategoryPreset } from '../types';

interface CalendarViewProps {
  tasks: Task[];
  onToggleTask: (id: string) => void;
  onAddTask: (title: string, category: string, date: string, priority: 'low' | 'medium' | 'high') => void;
  categories: CategoryPreset[];
}

export function CalendarView({ tasks, onToggleTask, onAddTask, categories }: CalendarViewProps) {
  // Initialize to current date
  const [currentDate, setCurrentDate] = useState(new Date());
  const [selectedDateStr, setSelectedDateStr] = useState(getFormattedDateString(new Date()));
  const [quickAddTitle, setQuickAddTitle] = useState('');

  const year = currentDate.getFullYear();
  const month = currentDate.getMonth();

  // Get start of month and total days
  const startOfMonth = new Date(year, month, 1);
  const startDayIndex = startOfMonth.getDay(); // 0 is Sunday, 6 is Saturday
  const totalDays = new Date(year, month + 1, 0).getDate();

  // Previous month total days
  const prevMonthTotalDays = new Date(year, month, 0).getDate();

  // Create dates grid arrays
  const daysArray: { day: number; isCurrentMonth: boolean; dateStr: string }[] = [];

  // Previous month's trailing days
  for (let i = startDayIndex - 1; i >= 0; i--) {
    const d = prevMonthTotalDays - i;
    const prevMonthDate = new Date(year, month - 1, d);
    daysArray.push({
      day: d,
      isCurrentMonth: false,
      dateStr: getFormattedDateString(prevMonthDate)
    });
  }

  // Current month's days
  for (let d = 1; d <= totalDays; d++) {
    const currentMonthDate = new Date(year, month, d);
    daysArray.push({
      day: d,
      isCurrentMonth: true,
      dateStr: getFormattedDateString(currentMonthDate)
    });
  }

  // Next month's leading days (pad to multiple of 7, up to 42 total slots)
  const remainingSlots = 42 - daysArray.length;
  for (let d = 1; d <= remainingSlots; d++) {
    const nextMonthDate = new Date(year, month + 1, d);
    daysArray.push({
      day: d,
      isCurrentMonth: false,
      dateStr: getFormattedDateString(nextMonthDate)
    });
  }

  function getFormattedDateString(date: Date) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  const handlePrevMonth = () => {
    setCurrentDate(new Date(year, month - 1, 1));
  };

  const handleNextMonth = () => {
    setCurrentDate(new Date(year, month + 1, 1));
  };

  const handleSelectDay = (dateStr: string) => {
    setSelectedDateStr(dateStr);
  };

  const handleQuickAdd = (e: FormEvent) => {
    e.preventDefault();
    if (!quickAddTitle.trim()) return;
    onAddTask(
      quickAddTitle.trim(),
      categories[0]?.name || 'Work',
      selectedDateStr,
      'medium'
    );
    setQuickAddTitle('');
  };

  // Filter tasks belonging strictly to the selected day
  const selectedDayTasks = tasks.filter(t => t.date === selectedDateStr);

  const monthNames = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];

  // Helper to determine if a date standardly has active tasks
  const getTasksCountForDate = (dateStr: string) => {
    return tasks.filter(t => t.date === dateStr && !t.completed).length;
  };

  return (
    <div className="space-y-5 animate-fade-in" id="calendar-view-container">
      {/* Calendar Grid Container Card */}
      <div className="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/80 rounded-2xl p-4.5 shadow-sm">
        {/* Month Selector Grid Header */}
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-2">
            <span className="material-symbols-outlined text-green-600 dark:text-green-500 bg-green-50 dark:bg-green-950/40 p-1.5 rounded-lg">
              <Calendar className="w-5 h-5 text-green-600 dark:text-green-500" />
            </span>
            <h2 className="font-sans text-lg font-bold text-gray-800 dark:text-gray-100 select-none">
              {monthNames[month]} {year}
            </h2>
          </div>
          <div className="flex items-center gap-1 bg-gray-50 dark:bg-gray-800 p-0.5 rounded-lg border border-gray-100 dark:border-gray-800/50">
            <button
              onClick={handlePrevMonth}
              className="p-1 text-gray-500 hover:text-gray-800 dark:hover:text-white rounded-md hover:bg-white dark:hover:bg-gray-900 active:scale-95 transition-all"
              id="calendar-prev-month"
            >
              <ChevronLeft className="w-5 h-5" />
            </button>
            <button
              onClick={handleNextMonth}
              className="p-1 text-gray-500 hover:text-gray-800 dark:hover:text-white rounded-md hover:bg-white dark:hover:bg-gray-900 active:scale-95 transition-all"
              id="calendar-next-month"
            >
              <ChevronRight className="w-5 h-5" />
            </button>
          </div>
        </div>

        {/* Days of Week Header */}
        <div className="grid grid-cols-7 gap-1 text-center mb-1">
          {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((dayName, idx) => (
            <span
              key={idx}
              className="text-[11px] font-bold text-gray-400 dark:text-gray-600 uppercase tracking-wider py-1 select-none"
            >
              {dayName}
            </span>
          ))}
        </div>

        {/* Calendar Monthly Numbers Grid */}
        <div className="grid grid-cols-7 gap-y-1.5 gap-x-1">
          {daysArray.map((item, idx) => {
            const hasActiveTasks = getTasksCountForDate(item.dateStr) > 0;
            const isSelected = item.dateStr === selectedDateStr;
            const isToday = getFormattedDateString(new Date()) === item.dateStr;

            return (
              <div
                key={idx}
                onClick={() => handleSelectDay(item.dateStr)}
                className={`relative flex flex-col items-center justify-center py-2 h-10 w-full rounded-xl cursor-pointer select-none transition-all duration-150 ${
                  isSelected
                    ? 'bg-green-500 text-white shadow-sm font-bold scale-[1.04]'
                    : item.isCurrentMonth
                    ? isToday
                      ? 'bg-green-50 dark:bg-green-950/40 text-green-700 dark:text-green-400 font-semibold border border-green-200 dark:border-green-800'
                      : 'text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 font-medium'
                    : 'text-gray-300 dark:text-gray-700 hover:bg-gray-50/50 dark:hover:bg-gray-800/40'
                }`}
                id={`calendar-day-${item.dateStr}`}
              >
                <span className="text-sm font-sans">{item.day}</span>
                
                {/* Active scheduled tasks indicator indicator dot */}
                {hasActiveTasks && (
                  <span
                    className={`absolute bottom-1 w-1.2 h-1.2 rounded-full transition-colors ${
                      isSelected ? 'bg-white' : 'bg-green-500'
                    }`}
                  />
                )}
              </div>
            );
          })}
        </div>
      </div>

      {/* Selected Day Status & List Area */}
      <div className="space-y-3">
        <div className="flex items-center justify-between px-1">
          <div className="flex flex-col">
            <h3 className="font-sans text-[15px] font-bold text-gray-800 dark:text-gray-100 capitalize">
              {new Date(selectedDateStr).toLocaleDateString('en-US', {
                weekday: 'long',
                month: 'short',
                day: 'numeric'
              })}
            </h3>
            <p className="text-[11px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wide">
              {selectedDayTasks.length === 0
                ? 'No active tasks'
                : `${selectedDayTasks.filter(t => !t.completed).length} items remaining`}
            </p>
          </div>
        </div>

        {/* List of Tasks for selected date */}
        <div className="bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/60 rounded-2xl p-4 space-y-1 shadow-sm">
          <AnimatePresence mode="popLayout">
            {selectedDayTasks.length === 0 ? (
              <motion.div
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                className="flex flex-col items-center justify-center py-6 text-center text-gray-400 dark:text-gray-500"
              >
                <div className="bg-slate-50 dark:bg-slate-800/40 p-3 rounded-full mb-2">
                  <Clock className="w-5 h-5 text-gray-400 dark:text-gray-500" />
                </div>
                <p className="text-xs font-semibold">Nothing scheduled for this day</p>
                <p className="text-[10px] mt-0.5">Enter a task below to start the day strong</p>
              </motion.div>
            ) : (
              selectedDayTasks.map(task => (
                <motion.div
                  key={task.id}
                  initial={{ opacity: 0, y: 5 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, scale: 0.95 }}
                  className="flex items-center gap-3 py-2 border-b border-gray-50 dark:border-gray-800/40 last:border-0"
                >
                  <button
                    onClick={() => onToggleTask(task.id)}
                    className="flex-shrink-0 focus:outline-none cursor-pointer"
                  >
                    {task.completed ? (
                      <div className="w-5 h-5 rounded-full bg-green-500 flex items-center justify-center text-white">
                        <Check className="w-3.5 h-3.5 stroke-[3]" />
                      </div>
                    ) : (
                      <div className="w-5 h-5 rounded-full border-2 border-green-500/80 hover:border-green-500 text-transparent" />
                    )}
                  </button>
                  <span
                    className={`text-sm select-none font-medium truncate flex-grow ${
                      task.completed ? 'line-through text-gray-400 dark:text-gray-600' : 'text-gray-700 dark:text-gray-250'
                    }`}
                  >
                    {task.title}
                  </span>
                  
                  {/* Category Indicator Tag */}
                  <span className="text-[9px] px-2 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 rounded-md font-bold uppercase">
                    {task.category}
                  </span>
                </motion.div>
              ))
            )}
          </AnimatePresence>

          {/* Inline Quick Add Task for the selected date */}
          <form onSubmit={handleQuickAdd} className="mt-3 pt-3 border-t border-gray-50 dark:border-gray-800/60 flex gap-2">
            <input
              type="text"
              value={quickAddTitle}
              onChange={(e) => setQuickAddTitle(e.target.value)}
              placeholder="Add small task..."
              className="flex-grow bg-gray-50 dark:bg-gray-950 border border-gray-100 dark:border-gray-800/60 focus:ring-1 focus:ring-green-400 focus:border-green-400 focus:outline-none rounded-xl px-3 py-1.5 text-xs text-gray-800 dark:text-gray-100"
            />
            <button
              type="submit"
              className="bg-green-500 hover:bg-green-600 text-white rounded-xl px-2.5 py-1.5 flex items-center justify-center transition-colors active:scale-95 shadow-sm cursor-pointer"
            >
              <Plus className="w-4 h-4" />
            </button>
          </form>
        </div>
      </div>
    </div>
  );
}
